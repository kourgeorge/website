{%- comment -%}
  The "builds on" link on a journey paper card (_layouts/journey_entry.liquid):
  the earlier paper's short title (its title up to the first ":"), linking to
  its card on the same page.
{%- endcomment -%}
{%- assign short_title = entry.title | split: ':' | first | strip -%}
<a class="jr-builds-link" href="#paper-{{ entry.key }}" title="{{ entry.title | strip_html | normalize_whitespace | escape }}">{{ short_title }}</a>
