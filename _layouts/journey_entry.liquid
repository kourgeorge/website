---
---
{%- comment -%}
  One paper card for the "journey of ideas" on the Publications page
  (_includes/publications_journey.liquid uses it as a jekyll-scholar
  bibliography template: {% bibliography --template journey_entry ... %}).
  Based on al-folio's _layouts/bib.liquid: the author list (George Kour
  highlighted, "more authors" folding), the Abs / Bib pop-ups and the link
  buttons work the same way (the theme's common.js opens the .abstract.hidden
  and .bibtex.hidden blocks next to the .links row).
  Extra fields from _bibliography/papers.bib: tldr (one line), builds_on (the
  key of an earlier paper; links to its card, id "paper-<key>").
  Papers listed in the page's journey_hide_pdf front matter get no PDF button
  (their pdf link opens a different paper).
{%- endcomment -%}
{%- assign hide_pdf = false -%}
{%- if page.journey_hide_pdf contains entry.key -%}{%- assign hide_pdf = true -%}{%- endif -%}
{%- assign title_url = nil -%}
{%- if entry.doi -%}
  {%- assign title_url = entry.doi | prepend: 'https://doi.org/' -%}
{%- elsif entry.url -%}
  {%- assign title_url = entry.url -%}
{%- elsif entry.arxiv -%}
  {%- assign title_url = entry.arxiv | prepend: 'https://arxiv.org/abs/' -%}
{%- elsif entry.html and entry.html contains '://' -%}
  {%- assign title_url = entry.html -%}
{%- elsif entry.pdf and hide_pdf == false and entry.pdf contains '://' -%}
  {%- assign title_url = entry.pdf -%}
{%- endif -%}
<div class="gp-card jr-card" id="paper-{{ entry.key }}">
  <div class="jr-meta">
    {%- if entry.abbr %}<abbr class="badge rounded jr-venue">{{ entry.abbr }}</abbr>{% endif -%}
    {%- if entry.year %}<span class="jr-year">{{ entry.year }}</span>{% endif -%}
  </div>
  <div class="title jr-paper-title">
    {%- if title_url -%}
      <a href="{{ title_url }}">{{ entry.title }}</a>
    {%- else -%}
      {{ entry.title }}
    {%- endif -%}
  </div>
  <div class="author">
    {% assign author_array_size = entry.author_array | size %}
    {% assign author_array_limit = author_array_size %}
    {% if site.max_author_limit and author_array_size > site.max_author_limit %}
      {% assign author_array_limit = site.max_author_limit %}
    {% endif %}
    {%- for author in entry.author_array limit: author_array_limit -%}
      {% assign author_is_self = false %}
      {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
      {%- assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
      {% if site.scholar.last_name contains author_last_name %}
        {% if site.scholar.first_name contains author.first %}
          {% assign author_is_self = true %}
        {% endif %}
      {%- endif -%}
      {%- if forloop.length > 1 -%}
        {% if forloop.first == false -%}
          {%- if forloop.length > 2 %}, {% elsif forloop.length == 2 %}  {% endif %}
        {%- endif %}
        {%- if forloop.last and author_array_limit == author_array_size %}and {% endif -%}
      {% endif %}
      {%- if author_is_self -%}
        <em>
          {{- author.first }}
          {{ author_last_html -}}
        </em>
      {%- else -%}
        {{- author.first }}
        {{ author_last_html -}}
      {%- endif -%}
    {% endfor %}
    {%- assign more_authors = author_array_size | minus: author_array_limit -%}
    {%- assign more_authors_hide = more_authors | append: ' more author' -%}
    {% if more_authors > 0 %}
      {%- if more_authors > 1 -%}
        {% assign more_authors_hide = more_authors_hide | append: 's' %}
      {%- endif -%}
      {% assign more_authors_show = '' %}
      {%- for author in entry.author_array offset: author_array_limit -%}
        {% assign more_authors_show = more_authors_show | append: author.first | append: ' ' | append: author.last %}
        {% unless forloop.last %}
          {% assign more_authors_show = more_authors_show | append: ', ' %}
        {% endunless %}
      {%- endfor -%}
      {%- assign more_authors_show = more_authors_show | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
      , and
      <span
        class="more-authors"
        title="click to view {{ more_authors_hide }}"
        onclick="
            var element = this;
            element.setAttribute('title', '');
            var more_authors_text = element.textContent == '{{ more_authors_hide }}' ? '{{ more_authors_show }}' : '{{ more_authors_hide }}';
            var cursorPosition = 0;
            var textAdder = setInterval(function(){
              element.innerHTML = more_authors_text.substring(0, cursorPosition + 1);
              if (++cursorPosition == more_authors_text.length){
                clearInterval(textAdder);
              }
          }, '{{ site.more_authors_animation_delay }}');
        "
      >
        {{- more_authors_hide -}}
      </span>
    {% endif %}
  </div>
  {%- if entry.tldr %}
  <p class="jr-tldr"><strong class="jr-tldr-label">TL;DR</strong> {{ entry.tldr }}</p>
  {%- endif %}
  {%- if entry.builds_on %}
  <div class="jr-builds">builds on &larr; {% bibliography --template journey_ref --bibliography_list_tag ul --group_by none --query @*[key={{ entry.builds_on }}] %}</div>
  {%- endif %}
  <div class="links">
    {%- if entry.abstract %}
    <a class="abstract btn btn-sm z-depth-0" role="button">Abs</a>
    {%- endif %}
    {%- if entry.doi %}
    <a href="https://doi.org/{{ entry.doi }}" class="btn btn-sm z-depth-0" role="button" title="doi:{{ entry.doi }}">DOI</a>
    {%- endif %}
    {%- if entry.arxiv %}
    <a href="https://arxiv.org/abs/{{ entry.arxiv }}" class="btn btn-sm z-depth-0" role="button">arXiv</a>
    {%- endif %}
    {%- if entry.pdf and hide_pdf == false %}
      {%- if entry.pdf contains '://' %}
    <a href="{{ entry.pdf }}" class="btn btn-sm z-depth-0" role="button">PDF</a>
      {%- else %}
    <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">PDF</a>
      {%- endif %}
    {%- endif %}
    {%- if entry.html %}
      {%- if entry.html contains '://' %}
    <a href="{{ entry.html }}" class="btn btn-sm z-depth-0" role="button">HTML</a>
      {%- else %}
    <a href="{{ entry.html | prepend: '/assets/html/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">HTML</a>
      {%- endif %}
    {%- endif %}
    {%- if entry.code %}
    <a href="{{ entry.code }}" class="btn btn-sm z-depth-0" role="button">Code</a>
    {%- endif %}
    {%- if entry.dataset %}
    <a href="{{ entry.dataset }}" class="btn btn-sm z-depth-0" role="button">Dataset</a>
    {%- endif %}
    {%- if entry.bibtex_show %}
    <a class="bibtex btn btn-sm z-depth-0" role="button">Bib</a>
    {%- endif %}
  </div>
  {%- if entry.abstract %}
  <div class="abstract hidden">
    <p>{{ entry.abstract }}</p>
  </div>
  {%- endif %}
  {%- if entry.bibtex_show %}
  <div class="bibtex hidden">
    {% highlight bibtex %}
    {{- entry.bibtex | regex_replace: '\n[ \t]*(tldr|chapter|builds_on|talk_chapter)[ \t]*=[ \t]*\x7B[^\x7B\x7D]*\x7D,?', '' | hideCustomBibtex -}}
    {% endhighlight %}
  </div>
  {%- endif %}
</div>
