---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  {%- comment -%}
    Local change: pages with a banner (all but the 404 page) show the title
    in the banner (_includes/page_banner.liquid), so it is not repeated here.
  {%- endcomment -%}
  {% if page.permalink == '/404.html' %}
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">{{ page.description }}</p>
    </header>
  {% elsif page.description %}
    <header class="post-header">
      <p class="post-description">{{ page.description }}</p>
    </header>
  {% endif %}

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.plugins contains 'al_comments' %}
    {% include plugins/al_comments.liquid %}
  {% endif %}
</div>
