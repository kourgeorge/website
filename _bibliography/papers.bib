@inproceedings{keshet2016marketshare,
  abbr         = {ADMA},
  bibtex_show  = {true},
  author       = {Renato Keshet and
                  Alina Maor and
                  George Kour},
  title        = {Prediction-Based, Prioritized Market-Share Insight Extraction},
  booktitle    = {Advanced Data Mining and Applications - 12th International Conference,
                  {ADMA} 2016, Gold Coast, QLD, Australia, December 12-15, 2016, Proceedings},
  series       = {Lecture Notes in Computer Science},
  volume       = {10086},
  pages        = {81--94},
  year         = {2016},
  url          = {https://doi.org/10.1007/978-3-319-49586-6_6},
  doi          = {10.1007/978-3-319-49586-6_6},
  pdf          = {https://drive.google.com/open?id=1yrb60cFMBT7gWYZEmjH46kqNBTSziTs3},
  chapter      = {side},
  tldr         = {A business-insight system that scans thousands of market combinations, surfaces
                  the biggest market-share changes, and learns what the user finds significant.},
  abstract     = {We present an approach for Business Intelligence (BI), where market share changes
                  are tracked, evaluated, and prioritized dynamically and interactively. Out of all
                  the hundreds or thousands of possible combinations of sub-markets and players, the
                  system brings to the user those combinations where the most significant changes
                  have happened, grouped into related insights. Time-series prediction and user
                  interaction enable the system to learn what “significant” means to the user, and
                  adapt the results accordingly. The proposed approach captures key insights that
                  are missed by current top-down aggregative BI systems, and that are hard to be
                  spotted by humans (e.g., Cisco’s US market disruption in 2010).},
}

