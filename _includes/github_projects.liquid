{%- comment -%}
  Projects and data-sets on Links & Resources (data: _data/github_projects.yml),
  grouped by "group". Items are sorted by "order", so groups appear in the
  order of their first item. Each project is a small card in a grid (2 columns
  on wide screens, 1 on phones). Styles: .gh-projects and .gp-* classes in
  _sass/_custom.scss (its own classes, so Teaching's student projects list is
  not affected). All links are external, so the page works in the preview
  build too. markdown="0" keeps kramdown from changing the HTML.
{%- endcomment -%}
{%- assign gp_items = site.data.github_projects | sort: "order" -%}
{%- assign gp_groups = gp_items | group_by: "group" -%}
<section class="gh-projects" markdown="0">
{%- for group in gp_groups %}
<h5 class="gp-group">{{ group.name }}</h5>
<ul class="gp-grid">
{%- for p in group.items %}
<li class="gp-card">
<div class="gp-head">
<a class="gp-title" href="{{ p.url }}" target="_blank" rel="noopener noreferrer"><strong>{{ p.title }}</strong></a>
{%- if p.stars or p.language %}
<span class="gp-badges">
{%- if p.stars %}<span class="gp-tag gp-stars" title="GitHub stars">&#9733; {{ p.stars }}</span>{% endif -%}
{%- if p.language %}<span class="gp-tag">{{ p.language }}</span>{% endif -%}
</span>
{%- endif %}
</div>
<div class="gp-blurb">{{ p.blurb }}</div>
{%- if p.links %}
<div class="gp-links">
{%- if p.links.site %}<a href="{{ p.links.site }}" target="_blank" rel="noopener noreferrer">[site]</a>{% endif -%}
{%- if p.links.docs %}<a href="{{ p.links.docs }}" target="_blank" rel="noopener noreferrer">[docs]</a>{% endif -%}
{%- if p.links.pypi %}<a href="{{ p.links.pypi }}" target="_blank" rel="noopener noreferrer">[PyPI]</a>{% endif -%}
{%- if p.links.dataset %}<a href="{{ p.links.dataset }}" target="_blank" rel="noopener noreferrer">[dataset]</a>{% endif -%}
</div>
{%- endif %}
</li>
{%- endfor %}
</ul>
{%- endfor %}
</section>
