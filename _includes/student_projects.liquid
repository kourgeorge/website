{%- comment -%}
  Supervised student projects (data: _data/student_projects.yml), grouped by
  year, newest first. Used by _pages/teaching.md. Each project is a card in a
  grid (2 columns on wide screens, 1 on phones), drawn with the same .gp-*
  card styles as the projects on Links & Resources (the section also has the
  "gh-projects" class for that), plus a few .sp-* classes in
  _sass/_custom.scss (.student-projects). markdown="0" keeps kramdown from
  changing the HTML. The list sits under the workshop heading on Teaching, so
  each project's "workshop" field is kept in the data but not shown here.
{%- endcomment -%}
{%- assign sp_years = site.data.student_projects | group_by: "year" | sort: "name" | reverse -%}
<section class="student-projects gh-projects" markdown="0">
{%- for group in sp_years %}
<h5 class="gp-group sp-year">{{ group.name }}</h5>
<ul class="gp-grid">
{%- for p in group.items %}
{%- assign sp_url = p.links.page | default: p.links.github %}
<li class="gp-card sp-card">
<div class="gp-head">
{%- if sp_url %}
<a class="gp-title" href="{{ sp_url }}" target="_blank" rel="noopener noreferrer"><strong>{{ p.title }}</strong></a>
{%- else %}
<span class="gp-title"><strong>{{ p.title }}</strong></span>
{%- endif %}
{%- if p.tags %}
<span class="gp-badges">
{%- for t in p.tags %}<span class="gp-tag">{{ t }}</span>{% endfor -%}
</span>
{%- endif %}
</div>
{%- if p.students %}
<div class="sp-students">{{ p.students | join: ", " }}</div>
{%- endif %}
<div class="gp-blurb">{{ p.summary }}</div>
<div class="gp-links">
{%- if p.links.page %}<a href="{{ p.links.page }}" target="_blank" rel="noopener noreferrer">[project page]</a>{% endif -%}
{%- if p.links.github %}<a href="{{ p.links.github }}" target="_blank" rel="noopener noreferrer">[code]</a>{% endif -%}
{%- if p.links.demo %}<a href="{{ p.links.demo }}" target="_blank" rel="noopener noreferrer">[demo]</a>{% endif -%}
{%- if p.links.pypi %}<a href="{{ p.links.pypi }}" target="_blank" rel="noopener noreferrer">[PyPI]</a>{% endif -%}
</div>
</li>
{%- endfor %}
</ul>
{%- endfor %}
</section>
